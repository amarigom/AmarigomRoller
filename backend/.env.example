SECRET_KEY=generar-un-valor-largo-y-aleatorio-de-32-caracteres-o-mas
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# Orígenes del front permitidos (separados por coma). Si se omite se usan los de producción y localhost:3000
CORS_ORIGINS=http://localhost:3000

# Login: vida del token en minutos y bloqueo por intentos fallidos
JWT_EXPIRES_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Cotizaciones por correo (sin RESEND_API_KEY solo se registran en el log)
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=onboarding@resend.dev
QUOTE_RECIPIENT=correo-que-recibe-las-cotizaciones@ejemplo.com
